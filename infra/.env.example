# infra/.env.example — 키 "이름"만 담은 템플릿입니다.
#
#   cp infra/.env.example infra/.env   후 값을 채우세요.
#
# ⚠️ 이 파일에 실제 값을 적지 마세요. 이 파일은 커밋되고, .env는 커밋되지 않습니다
#    (.gitignore의 `.env` + `!.env.example` 한 쌍). 커밋된 키는 폐기·재발급 외에
#    되돌릴 방법이 없습니다.
#
# 규약: 앱 설정 클래스의 접두어와 이름을 맞추세요 (backend_core/config.py = ADGEN_).

# ── 공개 주소 / HTTPS 종단 (ADR-0016) ────────────────────────────────────────
# 앞단 프록시(caddy)가 서빙할 호스트명. **이 값 하나가 평문과 HTTPS 를 가릅니다.**
# 비우면 `:80` 평문(로컬/CI), 호스트명을 넣으면 인증서 자동 발급 + HTTPS.
# ⚠️ 배포에서 비워 두면 세션 쿠키가 `Secure` 라 브라우저가 버립니다 (2026-08-18 실측).
# ⚠️ 값을 커밋하지 마세요 - `<외부 IP>.sslip.io` 형태라 문자열 자체가 외부 IP 입니다.
ADGEN_PUBLIC_HOST=

# ── 앱 간 통신 ────────────────────────────────────────────────────────────────
# 컨테이너에서는 compose 서비스명(http://ai-engine:8100), 로컬 실행 시 localhost.
ADGEN_AI_ENGINE_URL=http://localhost:8100
# 이 시간을 넘긴 생성 호출은 "느린" 게 아니라 놓친 것 — 끊고 폴백합니다.
ADGEN_AI_ENGINE_TIMEOUT_S=8.0

# ── 모델 / 외부 API ──────────────────────────────────────────────────────────
# 스텁과 실물을 가르는 스위치 하나입니다 (구현_범위 1.1절). `model` 로 두면 요청마다
# 요금이 나갑니다. 키 없이 `model` 이면 렌더가 503 으로 실패합니다 - 스텁으로 되돌아가지
# 않습니다(그 결과가 측정값처럼 보이기 때문입니다).
ADGEN_GENERATION_MODE=stub
# ⚠️ 유료 키. ai-engine 전용입니다. backend 에 넣지 마세요.
ADGEN_MODEL_API_KEY=
# 검증 1순위가 통과시킨 모델. 비우면 코드 기본값(gpt-image-2)이 쓰입니다.
ADGEN_IMAGE_MODEL=
# ⚠️ 비우면 모델이 회차마다 품질 티어를 골라 비용이 2.3배까지 벌어집니다 (2026-08-13 실측).
#    받는 값이 확인되지 않아 기본은 미지정입니다 - 잘못된 값을 넣으면 전 회차가 400 입니다.
ADGEN_IMAGE_QUALITY=

# ── 벡터 DB (실제 인덱스 도입 시) ─────────────────────────────────────────────
# ADGEN_VECTOR_DB_URL=
# ADGEN_VECTOR_PERSIST_DIR=/data/index

# ── E2E 하네스 ───────────────────────────────────────────────────────────────
# 미설정이면 e2e 테스트가 전부 skip 됩니다 (스택이 없는 환경을 초록으로 유지).
# E2E_BASE_URL=http://localhost:8000

# ── 인증 (S0) ────────────────────────────────────────────────────────────────
# 세션 토큰 서명 키. **기본값이 없습니다** — 비어 있으면 인증 경로가 기동에 실패합니다.
# 커밋된 기본값은 곧 공개된 서명 키이고, 서명 키가 새면 전 계정을 위조할 수 있습니다
# (ADR-0013). 생성:  python -c "import secrets; print(secrets.token_urlsafe(32))"
ADGEN_SESSION_SECRET=
# 로그인 토큰 수명(초). 24시간 고정, 갱신 없음 (세션_보관_정책.md 1.4절).
# 업로드 사진의 24시간과 우연히 같을 뿐 근거가 다릅니다 — 한쪽을 바꿀 때 따라 바꾸지 마세요.
ADGEN_SESSION_MAX_AGE_S=86400
# 고정 계정. 가입이 501이라 계정이 들어오는 경로는 여기뿐입니다 (ADR-0008).
# JSON 배열이며 **비밀번호가 아니라 해시**를 담습니다. 평문을 여기 적지 마세요.
# 둘이 최소값입니다 — 하나면 "남의 세션"이 없어 INV-9의 404 경로를 지나지 않습니다.
# ⚠️ 해시의 `$`는 반드시 `$$`로 두 번 씁니다. compose가 `$`를 변수 참조로 읽어 값을 조용히 뭉갭니다 (infra/README.md "환경변수 값에 `$`가 들어갈 때").
# 예: ADGEN_ACCOUNTS=[{"login_id":"demo1","password_hash":"$$argon2id$$v=19$$m=65536,t=3,p=4$$c29tZXNhbHQ$$aGFzaA"}]
ADGEN_ACCOUNTS=

# ── 상태 저장소 (ADR-0010, ADR-0014) ─────────────────────────────────────────
# 업로드 사진과 결과 이미지. 비워 두면 compose가 /data/images를 씁니다.
# ⚠️ 이미지 안의 기본값은 상대 경로라 /app(root 소유) 아래로 풀립니다. 컨테이너에서
#    쓰는 값은 Dockerfile의 ENV와 compose가 정합니다 — 여기서 바꾸려면 볼륨이 붙는
#    /data 아래를 가리키세요. 2026-08-14에 이걸 놓쳐 첫 업로드에서 죽었습니다.
ADGEN_IMAGE_DIR=

# ── 카탈로그 ─────────────────────────────────────────────────────────────────
# 화풍 후보. **후보 목록은 아직 미확정입니다** (미결정_대장 A절 3번, 차단).
# 코드에 박지 않은 이유가 그것이고, 그래서 설정이 값을 넣는 유일한 통로입니다.
# 비어 있으면 GET /v1/art-styles가 빈 목록을 돌려줍니다 — 정상 동작이지 결함이 아닙니다.
# JSON 배열. 예: [{"artStyleId":"webtoon","name":"웹툰","exampleImageUrl":"..."}]
ADGEN_ART_STYLES=

# ── 생성 타임아웃 ────────────────────────────────────────────────────────────
# 앞의 둘은 **사용자가 기다리는** 호출이라 초 단위입니다.
# brief:fill은 유일하게 폴백이 있는 호출이라(ADR-0005) 넘겨도 degraded로 진행합니다.
ADGEN_BRIEF_FILL_TIMEOUT_S=15.0
# 시안 생성은 계약이 60초를 약속합니다 (API_계약.md 2절). 이 값이 곧 그 약속입니다.
ADGEN_DRAFT_TIMEOUT_S=60.0
# ⚠️ 렌더만 분 단위입니다. **기다리는 쪽이 사용자가 아니라 잡 워커**이기 때문이고
#    (ADR-0015), 그것이 유일한 이유입니다. 요청 경로로 되돌리면 안 됩니다.
ADGEN_RENDER_TIMEOUT_S=300.0

# ── 렌더 워커 (ADR-0015) ─────────────────────────────────────────────────────
# ⚠️ **배포에서 끄지 마세요.** 끄면 finalize는 계속 202를 돌려주는데 아무것도 실행되지
#    않습니다. 화면에는 영원히 도는 스피너로 보이고, 세션은 rendering에 갇힙니다
#    (그 상태에는 되돌아오는 간선이 없습니다). 테스트 스위트만 끕니다.
ADGEN_WORKER_ENABLED=true
# 워커가 큐를 들여다보는 주기(초). 같은 파일을 보는 폴링이라 짧아도 비용이 없습니다.
ADGEN_WORKER_POLL_INTERVAL_S=1.0
# 클라이언트에게 Retry-After로 알려 주는 주기(초). **위 값과 다릅니다** — 이쪽은 네트워크
# 너머의 폴링입니다. 큐가 밀릴 때 서버가 이 값을 늘려 조회 부하를 줄입니다.
ADGEN_JOB_POLL_INTERVAL_S=3

# ── 보존 기간 정리 배치 (세션_보관_정책 2절) ─────────────────────────────────
# ⚠️ 튜닝 손잡이가 아니라 **정책의 숫자**입니다. 줄이면 사용자가 작업을 되찾을 시간이
#    줄고, 늘리면 문서가 약속한 것보다 오래 개인정보를 들고 있게 됩니다.
#    바꾸려면 docs/기술문서/세션_보관_정책.md 를 먼저 고치세요.
# 업로드 사진은 렌더 도달 여부와 무관하게 업로드 시점부터 셉니다.
ADGEN_RETENTION_PHOTO_H=24.0
ADGEN_RETENTION_SESSION_D=7.0
# 배치 주기. 일 1회. 시작할 때 한 번 쓸고 그다음 이 주기마다 돕니다.
ADGEN_SWEEP_INTERVAL_S=86400.0
# ⚠️ **배포에서 끄지 마세요.** 끄면 만료가 멈추는데 화면에는 아무 증상이 없고,
#    디스크와 보존 정책만 조용히 어긋납니다. 테스트 스위트만 끕니다.
ADGEN_SWEEP_ENABLED=true
