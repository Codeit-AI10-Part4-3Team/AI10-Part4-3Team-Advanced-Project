# CODEOWNERS — 경로별 기본 리뷰어 자동 배정.
#
# ⚠️ 이 파일은 **템플릿 상태**입니다. `{{GITHUB_OWNER}}` 자리를 실제 GitHub 계정으로 바꾸고,
#    아래 규칙을 팀 구성에 맞게 다시 쓰세요. 그 전까지는 아무것도 배정되지 않습니다.
#
# ⚠️ @핸들은 **GitHub 계정 ID**여야 합니다. 실명이나 없는 계정을 적으면 조용히 무시되고
#    리뷰어 자동 배정이 통째로 동작하지 않습니다. 또한 레포에 write 권한이 있어야 오너로 인정됩니다.
# ⚠️ **모든 경로의 오너는 2명 이상**이어야 합니다. PR 작성자 본인의 승인은 코드오너 승인으로
#    카운트되지 않으므로, 단독 소유 경로는 그 오너 자신의 PR이 영구히 머지 불가가 됩니다
#    (setup-github.sh의 require_code_owner_reviews=true 상태에서 발동).
#    → 경로를 추가할 때 담당자 + 백업 리뷰어를 반드시 함께 적으세요.
# ⚠️ 무료 플랜 private 리포에서는 CODEOWNERS가 동작하지 않습니다 (파일은 무해하게 남습니다).
#
# 위치: 레포 루트. GitHub은 루트 / .github/ / docs/ 중 **한 곳만** 읽으므로 사본을 만들지 마세요.
# 문법: <경로 패턴> <@계정 또는 @org/팀>
# ⚠️ 뒤에 오는 규칙이 앞을 덮어씁니다 — 더 좁은 경로를 아래쪽에 두세요.

# 기본 소유자 — 계약·스캐폴딩을 총괄하는 사람 + 백업
*                            @{{GITHUB_OWNER}} @teammate-backup

# 모듈 오너 (docs/역할_가이드/ 와 1:1로 맞추세요) — 담당자 + 백업
/apps/backend/               @teammate-backend @{{GITHUB_OWNER}}
/apps/ai-engine/             @teammate-ai @{{GITHUB_OWNER}}
/apps/frontend/              @teammate-frontend @{{GITHUB_OWNER}}
/packages/contracts/         @{{GITHUB_OWNER}} @teammate-backend
/infra/                      @teammate-backend @{{GITHUB_OWNER}}
/docs/adr/                   @{{GITHUB_OWNER}} @teammate-backup

# 평가 하네스는 ai-engine 소속이지만 채점 기준은 QA와 공동 소유 (자기채점 편향 방지)
/apps/ai-engine/eval/        @teammate-ai @teammate-qa

# 앱을 가로지르는 관통 테스트 — 특정 앱이 아니라 QA 소유 (+ 백업)
/e2e/                        @teammate-qa @{{GITHUB_OWNER}}

# 파이프라인·품질 게이트 변경은 영향 범위가 넓으므로 리드 + QA 동시 리뷰
/.github/                    @{{GITHUB_OWNER}} @teammate-qa
/scripts/                    @{{GITHUB_OWNER}} @teammate-qa
